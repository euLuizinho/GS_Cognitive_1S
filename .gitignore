# ============================================================
# .gitignore — Detecção de Buracos em Vias Urbanas (YOLOv8)
# ============================================================

# ----- Dataset (NÃO versionar imagens e anotações brutas) ---
data/
datasets/
*.zip
*.tar
*.gz

# ----- Modelos treinados grandes (pesos binários pesados) ----
# models/best.pt pode ser preservado ou adicionado via releases
models/*.engine
models/*.onnx
!models/.gitkeep

# ----- Resultados e Comprovações de Métricas (GS FIAP) ------
# Permite versionar as métricas oficiais e gráficos de comprovação
results/*
!results/.gitkeep
!results/*.json
!results/*.png
!results/*.jpg

# ----- Python e Bytecode ------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ----- Ambientes virtuais ----------------------------------
env/
venv/
.env
.venv
ENV/

# ----- Jupyter Notebooks ------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ----- IDEs e Editores --------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Logs de Execução e Runs Temporárias ------------------
*.log
runs/
wandb/
mlruns/
*.tmp
